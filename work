document.addEventListener("DOMContentLoaded", initAutoLogin);
async function initAutoLogin() {
  const shouldRedirect = sessionStorage.getItem("redirect") === "true";
  const encData = sessionStorage.getItem("encUserData");
  if (!shouldRedirect || !encData) return;

  try {
    const { username, password } = JSON.parse(encData);
    const { username: email, password: pass } = decryptStoredData(username, password);
    const emailField = await waitForElement("#userName");
    const passField = await waitForElement("#password");
    const loginButton = await waitForElement("#login-btn");

    await waitForRecaptcha();

    emailField.value = email;
    passField.value = pass;
    loginButton.disabled = false;
    loginButton.removeAttribute("disabled");

    requestAnimationFrame(() => loginButton.click());
  } catch (err) {
    console.error("Autofill error:", err);
  } finally {

    sessionStorage.removeItem("redirect");
    sessionStorage.removeItem("encUserData");
  }
}

function waitForElement(selector) {
  return new Promise(resolve => {
    const check = () => {
      const el = document.querySelector(selector);
      if (el) return resolve(el);
      requestAnimationFrame(check);
    };
    check();
  });
}

function waitForRecaptcha(timeout = 1000) {
  return new Promise(resolve => {
    if (globalThis.grecaptcha?.render) {
      return resolve();
    }
    const interval = setInterval(() => {
      if (globalThis.grecaptcha?.render) {
        clearInterval(interval);
        resolve();
      }
    }, 50);
    setTimeout(() => {
      clearInterval(interval);
      resolve(); // never block login
    }, timeout);
  });
}


function decryptStoredData(usn, pass) {
  console.log("decrypting creds");
  const secretKey = 'your-secret-key'; 
  const decryptedEmail = CryptoJS.AES.decrypt(usn, secretKey).toString(CryptoJS.enc.Utf8);
  const decryptedPassword = CryptoJS.AES.decrypt(pass, secretKey).toString(CryptoJS.enc.Utf8);

  return {
    username: decryptedEmail,
    password: decryptedPassword
  };
}

